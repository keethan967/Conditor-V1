# ---------------------------------------------------------------------------
# Conditor — environment configuration
#
# Copy to `.env.local` (which is git-ignored) and fill in the values.
# `src/lib/env.ts` validates these at startup, so a missing or malformed value
# fails the build with a readable message rather than at runtime in front of a
# user.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
# Safe to expose: the anon key is designed to be public and is constrained by
# Row Level Security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Absolute origin of this deployment. Used to build OAuth redirect URLs and
# absolute links in emails — a wrong value here silently breaks the auth
# callback in production while working fine locally.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Bypasses Row Level Security entirely. Required only for privileged server
# operations (webhooks, admin tooling, background jobs). Leave unset locally
# unless you are working on one of those.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
